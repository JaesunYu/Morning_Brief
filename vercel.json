{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/market.js": {
      "maxDuration": 30
    },
    "api/yahoo/[...path].js": {
      "maxDuration": 30
    },
    "api/cnn-fng/[...path].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ]
}
